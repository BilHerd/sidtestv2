100 REM SID2K TEST APPLICATION V2.02
110 REM FULL KEYBOARD SUPPORT FIXED
120 V$="V2.02"
125 REM INITIALIZE CURSOR POSITION
126 CX=0:CY=0:REM CURSOR X,Y FOR REGISTER SELECTION
130 POKE 53280,0:POKE 53281,0:PRINT CHR$(147)
140 PRINT TAB(10);"SID2K TEST APPLICATION"
150 PRINT TAB(17);V$;TAB(27);"VOLUME OFF"
160 PRINT
170 PRINT "TEST MODE: FREQUENCY SWEEP"
180 PRINT "TEST RUNNING: STOPPED"
190 PRINT
200 PRINT " 1  START/STOP TEST"
210 PRINT " 2  RESET TEST"
220 PRINT " 3  CHANGE TEST"
230 PRINT " +  ADJUST VOLUME"
240 PRINT "CRSR SELECT REGISTER"
250 PRINT " 0-F ENTER HEX VALUE"
260 PRINT " D  SET DEFAULT VALUES"
270 PRINT
280 PRINT "-400 00 00 00 00 00 00 F0  V1 FREQ LO"
290 PRINT "-401 00 00 00 00 00 00 F0"
300 PRINT "-40E 00 00 00 0F FF FF 00"
310 PRINT "-415 00 00 00 FF FF 00"
320 PRINT " G:  00.00 00 00 00 00 00 00 00 00 00 00"
330 REM SHOW INITIAL CURSOR
335 GOSUB 3500
340 REM MAIN LOOP
350 GET K$
360 IF K$="" THEN 350
365 REM CHECK FOR CURSOR MOVEMENT
370 IF K$=CHR$(29) THEN GOSUB 3000:GOTO 350:REM RIGHT
375 IF K$=CHR$(157) THEN GOSUB 3100:GOTO 350:REM LEFT
380 IF K$=CHR$(17) THEN GOSUB 3200:GOTO 350:REM DOWN
385 IF K$=CHR$(145) THEN GOSUB 3300:GOTO 350:REM UP
390 REM CHECK FOR HEX INPUT
395 IF K$>="0" AND K$<="9" THEN GOSUB 4000:GOTO 350
400 IF K$>="A" AND K$<="F" THEN GOSUB 4000:GOTO 350
405 IF K$>="a" AND K$<="f" THEN K$=CHR$(ASC(K$)-32):GOSUB 4000:GOTO 350
410 REM CHECK FOR FUNCTION KEYS
415 IF K$="1" THEN GOSUB 1000:GOTO 350
420 IF K$="2" THEN GOSUB 1100:GOTO 350
425 IF K$="3" THEN GOSUB 1200:GOTO 350
430 IF K$="+" OR K$="-" THEN GOSUB 1300:GOTO 350
435 IF K$="D" OR K$="d" THEN GOSUB 500:GOTO 350
440 IF K$=CHR$(13) THEN END
450 GOTO 350
500 REM *** DEFAULT VALUES SETUP ***
510 REM VOICE 1 - SAWTOOTH
520 POKE 54272,0:REM FREQ LO
530 POKE 54273,16:REM FREQ HI (4096 HZ)
540 POKE 54274,0:REM PULSE LO
550 POKE 54275,8:REM PULSE HI (50%)
560 POKE 54276,33:REM SAWTOOTH + GATE ON
570 POKE 54277,0:REM ATTACK=0, DECAY=0
580 POKE 54278,249:REM SUSTAIN=15, RELEASE=9
590 REM VOICE 2 - TRIANGLE
600 POKE 54279,0:REM FREQ LO
610 POKE 54280,32:REM FREQ HI
620 POKE 54281,0:REM PULSE LO
630 POKE 54282,8:REM PULSE HI
640 POKE 54283,17:REM TRIANGLE + GATE ON
650 POKE 54284,0:REM ATTACK=0, DECAY=0
660 POKE 54285,249:REM SUSTAIN=15, RELEASE=9
670 REM VOICE 3 - PULSE
680 POKE 54286,0:REM FREQ LO
690 POKE 54287,64:REM FREQ HI
700 POKE 54288,0:REM PULSE LO
710 POKE 54289,8:REM PULSE HI (50%)
720 POKE 54290,65:REM PULSE + GATE ON
730 POKE 54291,0:REM ATTACK=0, DECAY=0
740 POKE 54292,249:REM SUSTAIN=15, RELEASE=9
750 REM FILTER & VOLUME
760 POKE 54293,0:REM FILTER CUTOFF LO
770 POKE 54294,128:REM FILTER CUTOFF HI (MIDPOINT)
780 POKE 54295,247:REM ROUTE ALL VOICES TO FILTER, RESONANCE=15
790 POKE 54296,63:REM LOW-PASS FILTER + MAX VOL + EXT AUDIO ON
800 REM UPDATE DISPLAY
810 PRINT CHR$(19)
820 FOR I=1 TO 2:PRINT CHR$(17):NEXT
830 PRINT TAB(27);"VOLUME ON "
840 GOSUB 2000:REM UPDATE REGISTER DISPLAY
850 RETURN
1000 REM START/STOP TEST
1010 REM TOGGLE TEST STATE
1020 RETURN
1100 REM RESET TEST
1110 FOR I=54272 TO 54296:POKE I,0:NEXT
1120 PRINT CHR$(19)
1130 FOR I=1 TO 2:PRINT CHR$(17):NEXT
1140 PRINT TAB(27);"VOLUME OFF"
1150 GOSUB 2000:REM UPDATE DISPLAY
1160 RETURN
1200 REM CHANGE TEST MODE
1210 REM CYCLE THROUGH TEST MODES
1220 RETURN
1300 REM ADJUST VOLUME
1310 V=PEEK(54296) AND 15
1320 IF K$="+" THEN V=V+1:IF V>15 THEN V=15
1330 IF K$="-" THEN V=V-1:IF V<0 THEN V=0
1340 POKE 54296,(PEEK(54296) AND 240) OR V
1350 RETURN
2000 REM UPDATE REGISTER DISPLAY
2010 PRINT CHR$(19)
2020 FOR L=1 TO 9:PRINT CHR$(17):NEXT
2030 REM UPDATE -400 LINE
2040 PRINT "-400 ";
2050 FOR I=0 TO 6
2060 V=PEEK(54272+I):GOSUB 2500:PRINT H$;" ";
2070 NEXT:PRINT "F0  V1 FREQ LO"
2080 REM UPDATE -401 LINE
2090 PRINT "-401 ";
2100 FOR I=7 TO 13
2110 V=PEEK(54272+I):GOSUB 2500:PRINT H$;" ";
2120 NEXT:PRINT "F0"
2130 REM UPDATE -40E LINE
2140 PRINT "-40E ";
2150 FOR I=14 TO 20
2160 V=PEEK(54272+I):GOSUB 2500:PRINT H$;" ";
2170 NEXT:PRINT "00"
2180 REM UPDATE -415 LINE
2190 PRINT "-415 ";
2200 FOR I=21 TO 24
2210 V=PEEK(54272+I):GOSUB 2500:PRINT H$;" ";
2220 NEXT:PRINT "FF FF 00"
2230 RETURN
2500 REM CONVERT BYTE TO HEX STRING
2510 H$=""
2520 N1=INT(V/16):N2=V-N1*16
2530 IF N1<10 THEN H$=H$+CHR$(48+N1):GOTO 2550
2540 H$=H$+CHR$(65+N1-10)
2550 IF N2<10 THEN H$=H$+CHR$(48+N2):GOTO 2570
2560 H$=H$+CHR$(65+N2-10)
2570 RETURN
3000 REM CURSOR RIGHT
3010 CX=CX+1
3020 IF CY=0 AND CX>6 THEN CX=0:CY=1
3030 IF CY=1 AND CX>6 THEN CX=0:CY=2
3040 IF CY=2 AND CX>6 THEN CX=0:CY=3
3050 IF CY=3 AND CX>3 THEN CX=0:CY=0
3060 GOSUB 3500:REM UPDATE CURSOR DISPLAY
3070 RETURN
3100 REM CURSOR LEFT
3110 CX=CX-1
3120 IF CX<0 AND CY=0 THEN CX=3:CY=3
3130 IF CX<0 AND CY=1 THEN CX=6:CY=0
3140 IF CX<0 AND CY=2 THEN CX=6:CY=1
3150 IF CX<0 AND CY=3 THEN CX=6:CY=2
3160 GOSUB 3500:REM UPDATE CURSOR DISPLAY
3170 RETURN
3200 REM CURSOR DOWN
3210 CY=CY+1:IF CY>3 THEN CY=0
3220 IF CY=3 AND CX>3 THEN CX=3
3230 GOSUB 3500:REM UPDATE CURSOR DISPLAY
3240 RETURN
3300 REM CURSOR UP
3310 CY=CY-1:IF CY<0 THEN CY=3
3320 IF CY=3 AND CX>3 THEN CX=3
3330 GOSUB 3500:REM UPDATE CURSOR DISPLAY
3340 RETURN
3500 REM UPDATE CURSOR DISPLAY
3510 REM FIRST CLEAR OLD CURSOR
3520 GOSUB 2000:REM REDRAW CLEAN DISPLAY
3530 REM POSITION TO REGISTER LOCATION
3540 PRINT CHR$(19):REM HOME
3550 FOR I=1 TO 9+CY:PRINT CHR$(17):NEXT:REM DOWN TO LINE
3560 FOR I=1 TO 5+CX*3:PRINT CHR$(29):NEXT:REM RIGHT TO POSITION
3570 REM SHOW CURSOR (REVERSE VIDEO)
3580 PRINT CHR$(18);:REM REVERSE ON
3590 REM GET AND REPRINT CURRENT VALUE
3600 IF CY=0 THEN R=CX
3610 IF CY=1 THEN R=7+CX
3620 IF CY=2 THEN R=14+CX
3630 IF CY=3 THEN R=21+CX
3640 V=PEEK(54272+R):GOSUB 2500
3650 PRINT H$;
3660 PRINT CHR$(146);:REM REVERSE OFF
3670 RETURN
4000 REM HEX INPUT
4010 REM CALCULATE REGISTER ADDRESS
4020 IF CY=0 THEN R=CX
4030 IF CY=1 THEN R=7+CX
4040 IF CY=2 THEN R=14+CX
4050 IF CY=3 THEN R=21+CX
4060 REM GET CURRENT VALUE
4070 V=PEEK(54272+R)
4080 REM SHIFT AND ADD NEW DIGIT
4090 V=(V AND 15)*16
4100 IF K$>="0" AND K$<="9" THEN V=V+(ASC(K$)-48)
4110 IF K$>="A" AND K$<="F" THEN V=V+(ASC(K$)-65+10)
4120 IF V>255 THEN V=255
4130 REM WRITE NEW VALUE
4140 POKE 54272+R,V
4150 REM UPDATE DISPLAY AND CURSOR
4160 GOSUB 3500
4170 RETURN